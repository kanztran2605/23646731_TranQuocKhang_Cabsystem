# =========================================================
# CAB SYSTEM - LOCAL DEMO ENV
# Copy to .env. Never commit the real .env.
# =========================================================
NODE_ENV=development
LOG_LEVEL=info

# Gateway
GATEWAY_PORT=8080
JWT_SECRET=change-me-demo-jwt-secret
JWT_ACCESS_TTL_SECONDS=3600
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=3

# Demo values
OTP_MOCK_CODE=123
PAYMENT_DEMO_AMOUNT=50000
BOOKING_MATCH_RADIUS_KM=1
BOOKING_MATCH_CANDIDATE_LIMIT=20
# DEVELOPMENT/DEMO ONLY: 32-byte AES-256-GCM key used by seeded Driver licenses.
DATA_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# PostgreSQL - one container / seven logical DBs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cab
POSTGRES_PASSWORD=change-me
AUTH_DB_NAME=auth_db
CUSTOMER_DB_NAME=customer_db
DRIVER_DB_NAME=driver_db
BOOKING_DB_NAME=booking_db
TRIP_DB_NAME=trip_db
PAYMENT_DB_NAME=payment_db
REVIEW_DB_NAME=review_db

# MongoDB - notification-service only
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=cab
MONGO_PASSWORD=change-me
MONGO_DB_NAME=notification_db
MONGO_AUTH_SOURCE=admin

# Redis - Gateway infrastructure only
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cab
RABBITMQ_PASSWORD=change-me
RABBITMQ_EXCHANGE=cab.events

# gRPC ports
AUTH_GRPC_PORT=50051
CUSTOMER_GRPC_PORT=50052
DRIVER_GRPC_PORT=50053
BOOKING_GRPC_PORT=50054
TRIP_GRPC_PORT=50055
PAYMENT_GRPC_PORT=50056
NOTIFICATION_GRPC_PORT=50057
REVIEW_GRPC_PORT=50058

# gRPC Docker service names
AUTH_GRPC_HOST=auth-service
CUSTOMER_GRPC_HOST=customer-service
DRIVER_GRPC_HOST=driver-service
BOOKING_GRPC_HOST=booking-service
TRIP_GRPC_HOST=trip-service
PAYMENT_GRPC_HOST=payment-service
NOTIFICATION_GRPC_HOST=notification-service
REVIEW_GRPC_HOST=review-service
