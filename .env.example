# =========================================================
# CAB SYSTEM - ENVIRONMENT TEMPLATE
# =========================================================

NODE_ENV=development

# =========================================================
# API GATEWAY
# =========================================================

API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_REQUESTS=1000

# =========================================================
# AUTHENTICATION / SECURITY
# =========================================================

JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY
INTERNAL_SERVICE_KEY=CHANGE_ME

BCRYPT_SALT_ROUNDS=12

# =========================================================
# POSTGRESQL
# One PostgreSQL instance for local development.
# Each service owns a logical database.
# =========================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cab_user
POSTGRES_PASSWORD=CHANGE_ME

AUTH_DB=auth_db
CUSTOMER_DB=customer_db
DRIVER_DB=driver_db
BOOKING_DB=booking_db
TRIP_DB=trip_db
PAYMENT_DB=payment_db
NOTIFICATION_DB=notification_db
REVIEW_DB=review_db
REPORTING_DB=reporting_db
AUDIT_DB=audit_db

# =========================================================
# REDIS
# =========================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# =========================================================
# RABBITMQ
# =========================================================

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_USER=cab_user
RABBITMQ_PASSWORD=CHANGE_ME

RABBITMQ_EXCHANGE=cab.events
RABBITMQ_EXCHANGE_TYPE=topic

# =========================================================
# SERVICE HTTP PORTS
# Used for health / ready endpoints
# =========================================================

AUTH_HTTP_PORT=3001
CUSTOMER_HTTP_PORT=3002
DRIVER_HTTP_PORT=3003
BOOKING_HTTP_PORT=3004
TRIP_HTTP_PORT=3005
PAYMENT_HTTP_PORT=3006
NOTIFICATION_HTTP_PORT=3007
REVIEW_HTTP_PORT=3008
REPORT_HTTP_PORT=3009
AUDIT_HTTP_PORT=3010

# =========================================================
# SERVICE gRPC PORTS
# =========================================================

AUTH_GRPC_PORT=50051
CUSTOMER_GRPC_PORT=50052
DRIVER_GRPC_PORT=50053
BOOKING_GRPC_PORT=50054
TRIP_GRPC_PORT=50055
PAYMENT_GRPC_PORT=50056
NOTIFICATION_GRPC_PORT=50057
REVIEW_GRPC_PORT=50058
REPORT_GRPC_PORT=50059
AUDIT_GRPC_PORT=50060

# =========================================================
# INTERNAL SERVICE HOSTS
# Docker service DNS names
# =========================================================

AUTH_SERVICE_HOST=auth-service
CUSTOMER_SERVICE_HOST=customer-service
DRIVER_SERVICE_HOST=driver-service
BOOKING_SERVICE_HOST=booking-service
TRIP_SERVICE_HOST=trip-service
PAYMENT_SERVICE_HOST=payment-service
NOTIFICATION_SERVICE_HOST=notification-service
REVIEW_SERVICE_HOST=review-service
REPORT_SERVICE_HOST=report-service
AUDIT_SERVICE_HOST=audit-service

# =========================================================
# EXTERNAL PROVIDERS
# MVP can use MOCK mode
# =========================================================

MAP_PROVIDER_MODE=mock
MAP_PROVIDER_BASE_URL=
MAP_PROVIDER_API_KEY=

PAYMENT_PROVIDER_MODE=mock
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_CALLBACK_SECRET=CHANGE_ME

NOTIFICATION_PROVIDER_MODE=mock
NOTIFICATION_PROVIDER_BASE_URL=
NOTIFICATION_PROVIDER_API_KEY=

# =========================================================
# LOGGING
# =========================================================

LOG_LEVEL=info

AUTH_DB_NAME=auth_db
CUSTOMER_DB_NAME=customer_db

BCRYPT_ROUNDS=12

JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_TTL_SECONDS=600

AUTH_MOCK_OTP_ENABLED=true
AUTH_MOCK_OTP_CODE=CHANGE_ME_DEV_ONLY

DRIVER_DB_NAME=driver_db

DATA_ENCRYPTION_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64_KEY
DATA_ENCRYPTION_KEY_VERSION=1