# =========================================================
# CAB System - Git Ignore
# =========================================================

# Git
.git/

# Local AI/cache state (project instructions and documentation are versioned)
.ai/

# Environment / secrets
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/

# Tests / coverage
coverage/
**/coverage/
.nyc_output/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo

# IDE
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local Docker data
docker-data/
postgres-data/
rabbitmq-data/
redis-data/

# Generated artifacts; authoritative docs and Postman files are versioned
reports/
outputs/

# Local certificates / keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Database dumps
.backups/
*.dump
*.backup
*.sql.gz

# Misc cache
.cache/
.eslintcache
__pycache__/
*.pyc
