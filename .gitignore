# =========================================================
# CAB System - Git Ignore
# =========================================================

# Environment / secrets
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo

# Runtime
*.pid
*.pid.lock

# IDE
.vscode/
.idea/
*.code-workspace

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Docker local volumes
docker-data/
postgres-data/
rabbitmq-data/
redis-data/

# Local certificates / keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Local database dump
*.dump
*.sql.gz
*.backup

# Misc
.cache/
.eslintcache